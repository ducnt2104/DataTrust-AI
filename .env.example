# DataTrust Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Server Configuration
PORT=8000
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_PATH=backend/data/datatrust.db

# Google Gemini AI Configuration
# Obtain your key securely from Google AI Studio: https://aistudio.google.com/
# Set your replacement API key here (never share in chat or public repos):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=45
